{
  "name": "local-leads",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:server\" \"npm:start\"",
    "server": "tsx watch server/index.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "tsx --test server/*.spec.ts",
    "typecheck:server": "tsc -p server"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "rxjs": "~7.8.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@types/d3-geo": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "concurrently": "^10.0.6",
    "jsdom": "^27.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
